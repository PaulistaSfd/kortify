# Copie para .env.local (local) e coloque também nos "Secrets" do Worker na Cloudflare.
# Sem as duas primeiras, o painel roda em modo exemplo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (onde ficam as lives e os cortes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kortify

# Senha que o servidor do motor (clipador.py) usa para falar com o site
WORKER_SECRET=

# Painel admin: e-mails que podem abrir /admin (separados por vírgula)
ADMIN_EMAILS=
# Asaas (Secret): chave da API e senha do webhook. Ambiente: sandbox ou producao
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_AMBIENTE=sandbox
